<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Version>0.1.0-beta.5</Version>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.5</FileVersion>
    <InformationalVersion>$(Version)</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- WinForms just for NotifyIcon / ContextMenuStrip in the tray service. -->
    <UseWindowsForms>true</UseWindowsForms>

    <!-- Keep WH_MOUSE_LL callback under LowLevelHooksTimeout (~300ms).
         Server GC = parallel, shorter pauses; SustainedLowLatency set at
         runtime prevents Gen2 blocking collections during drag. -->
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <TieredCompilation>true</TieredCompilation>
    <TieredPGO>true</TieredPGO>

    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- App icon (exe + window + tray). See Assets\logo.svg for the source. -->
    <Resource Include="Assets\app.ico" />
    <EmbeddedResource Include="Features\Updates\UpdateKeys.json" LogicalName="MagiDesk.UpdateKeys.json" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MagiDesk.Tests" />
    <!-- UseWindowsForms=true adds System.Drawing and System.Windows.Forms to
         ImplicitUsings globally, which collides with System.Windows.Media.Brush
         and System.Windows.Shapes.Rectangle in every WPF file. Strip those so
         the only WinForms use site (TrayService.cs) uses fully-qualified names. -->
    <Using Remove="System.Drawing" />
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="WPF-UI" Version="4.3.0" />
    <!-- WMI for reading chrome.exe command lines. -->
    <PackageReference Include="System.Management" Version="9.0.20" />
  </ItemGroup>


</Project>
