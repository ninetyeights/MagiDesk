<Application x:Class="MagiDesk.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:local="clr-namespace:MagiDesk"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- ThemesDictionary is inserted at index 0 from App.OnStartup
                     based on the current Windows light/dark setting. We avoid
                     declaring it here with a hard-coded Theme because once a
                     Light dictionary has merged at InitializeComponent time,
                     swapping its Source later doesn't reliably re-trigger
                     DynamicResource lookups already resolved by ControlsDictionary. -->
                <ui:ControlsDictionary/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Kill the dotted focus rectangle that shows up on Alt-press
                 / Tab navigation. Fluent design doesn't use these. -->
            <Style TargetType="{x:Type Control}">
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            </Style>
            <Style TargetType="{x:Type FrameworkElement}">
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
