<Window x:Class="MagiDesk.Features.QuickGrid.QuickGridWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quick Grid"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        SizeToContent="WidthAndHeight">
    <Border x:Name="OuterBorder"
            CornerRadius="12" Padding="18"
            BorderBrush="#50FFFFFF" BorderThickness="1"
            Background="#E81E1E22">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="32" ShadowDepth="8" Opacity="0.65"/>
        </Border.Effect>
        <StackPanel x:Name="Root" Focusable="True">
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" x:Name="TxtHint"
                           Foreground="#E8FFFFFF"
                           FontSize="12"
                           VerticalAlignment="Center"
                           Text="拖动选格子 · Esc 取消"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="BtnCenterKeep"
                            Content="仅居中"
                            Padding="12,4"
                            Margin="0,0,6,0"
                            Background="#30FFFFFF"
                            Foreground="White"
                            BorderBrush="#60FFFFFF"
                            BorderThickness="1"
                            ToolTip="保持窗口大小不变，只移动到显示器中央"
                            Click="BtnCenterKeep_Click"/>
                    <Button x:Name="BtnCenter"
                            Content="居中"
                            Padding="12,4"
                            Background="#30FFFFFF"
                            Foreground="White"
                            BorderBrush="#60FFFFFF"
                            BorderThickness="1"
                            ToolTip="居中并调整窗口大小（约 80% 工作区）"
                            Click="BtnCenter_Click"/>
                </StackPanel>
            </Grid>
            <Canvas x:Name="GridCanvas" Width="620" Height="340"
                    Background="Transparent"
                    MouseLeftButtonDown="Canvas_MouseLeftButtonDown"
                    MouseMove="Canvas_MouseMove"
                    MouseLeftButtonUp="Canvas_MouseLeftButtonUp"
                    MouseLeave="Canvas_MouseLeave"/>
        </StackPanel>
    </Border>
</Window>
