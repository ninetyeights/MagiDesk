<Window x:Class="MagiDesk.Features.QuickGrid.QuickGridWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="快速网格"
        FontFamily="Segoe UI" FontSize="14"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        SizeToContent="WidthAndHeight" MinWidth="0" MinHeight="0" Padding="0">
    <Window.Resources>
        <Style x:Key="DensityArrowStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource ControlFillColorTertiaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Window.Template>
        <ControlTemplate TargetType="{x:Type Window}">
            <AdornerDecorator><ContentPresenter/></AdornerDecorator>
        </ControlTemplate>
    </Window.Template>
    <Border x:Name="OuterBorder"
            CornerRadius="12" Padding="16"
            BorderThickness="0"
            Background="{DynamicResource ApplicationBackgroundBrush}">
        <!-- Focus receives Esc/keyboard input without outlining the entire popup. -->
        <StackPanel x:Name="Root" Focusable="True" FocusVisualStyle="{x:Null}" Width="520">
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="TxtTarget" FontSize="14" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" MaxWidth="450" HorizontalAlignment="Left"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    <TextBlock Text="快速网格" FontSize="11" Margin="0,2,0,0"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
                <ui:Button Grid.Column="1" Width="28" Height="28" Padding="6"
                           Appearance="Transparent" ToolTip="关闭（Esc）" Click="BtnClose_Click">
                    <Path Data="M 0,0 L 10,10 M 10,0 L 0,10" StrokeThickness="1.2"
                          Stroke="{DynamicResource TextFillColorSecondaryBrush}"/>
                </ui:Button>
            </Grid>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,8">
                <ui:Button x:Name="BtnMonitorScope" Appearance="Transparent" Padding="10,5" Margin="0,0,8,0"
                           ToolTip="切换当前窗口所在屏幕／所有屏幕" Click="MonitorScope_Click"/>
                <ui:Button x:Name="BtnCenterKeep" Appearance="Transparent" Padding="10,5" Margin="0,0,4,0"
                           ToolTip="保持窗口大小不变，只移动到显示器中央" Click="BtnCenterKeep_Click">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="M 0,0 L 16,0 16,12 0,12 Z M 5,4 L 11,4 11,8 5,8 Z"
                              Stroke="{DynamicResource TextFillColorSecondaryBrush}" StrokeThickness="1"
                              VerticalAlignment="Center" Margin="0,0,7,0"/>
                        <TextBlock Text="仅居中" FontSize="12"/>
                    </StackPanel>
                </ui:Button>
                <ui:Button x:Name="BtnCenter" Appearance="Transparent" Padding="10,5"
                           ToolTip="居中并调整窗口大小（工作区宽度 80%、高度 90%）" Click="BtnCenter_Click">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="M 0,4 L 0,0 4,0 M 12,0 L 16,0 16,4 M 16,8 L 16,12 12,12 M 4,12 L 0,12 0,8 M 4,3 L 12,3 12,9 4,9 Z"
                              Stroke="{DynamicResource TextFillColorSecondaryBrush}" StrokeThickness="1"
                              VerticalAlignment="Center" Margin="0,0,7,0"/>
                        <TextBlock Text="大窗居中" FontSize="12"/>
                    </StackPanel>
                </ui:Button>
                <ui:Button Appearance="Transparent" Padding="10,5" Margin="4,0,0,0"
                           ToolTip="居中并调整窗口大小（工作区宽度 55%、高度 90%）" Click="BtnNarrowCenter_Click">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="M 0,0 L 16,0 16,12 0,12 Z M 5,2 L 11,2 11,10 5,10 Z"
                              Stroke="{DynamicResource TextFillColorSecondaryBrush}" StrokeThickness="1"
                              VerticalAlignment="Center" Margin="0,0,7,0"/>
                        <TextBlock Text="窄幅居中" FontSize="12"/>
                    </StackPanel>
                </ui:Button>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,8">
                <ComboBox x:Name="DensityMonitor" Width="116" Margin="0,0,8,0" Padding="8,4"
                          SelectionChanged="DensityMonitor_Changed"
                          ToolTip="选择要调整网格的显示器"/>
                <Button Content="2×2" Tag="2" Padding="6,3" Margin="0,0,4,0" Click="DensityPreset_Click"/>
                <Button Content="4×4" Tag="4" Padding="6,3" Margin="0,0,4,0" Click="DensityPreset_Click"/>
                <Button Content="6×6" Tag="6" Padding="6,3" Margin="0,0,8,0" Click="DensityPreset_Click"/>
                <TextBlock Text="行" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <Border BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4" Width="80" Height="28" VerticalAlignment="Center">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/></Grid.ColumnDefinitions>
                        <Button Style="{StaticResource DensityArrowStyle}" x:Name="RowsDown" Tag="Rows-" ToolTip="减少行数" Click="DensityStep_Click">
                            <Path Data="M 5,0 L 0,5 5,10" Stroke="{DynamicResource TextFillColorPrimaryBrush}" StrokeThickness="1.2"/>
                        </Button>
                        <TextBlock Grid.Column="1" x:Name="DensityRows" Text="1" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Button Grid.Column="2" Style="{StaticResource DensityArrowStyle}" x:Name="RowsUp" Tag="Rows+" ToolTip="增加行数" Click="DensityStep_Click">
                            <Path Data="M 0,0 L 5,5 0,10" Stroke="{DynamicResource TextFillColorPrimaryBrush}" StrokeThickness="1.2"/>
                        </Button>
                    </Grid>
                </Border>
                <TextBlock Text="列" VerticalAlignment="Center" Margin="8,0,4,0"/>
                <Border BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4" Width="80" Height="28" VerticalAlignment="Center">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/></Grid.ColumnDefinitions>
                        <Button Style="{StaticResource DensityArrowStyle}" x:Name="ColsDown" Tag="Cols-" ToolTip="减少列数" Click="DensityStep_Click">
                            <Path Data="M 5,0 L 0,5 5,10" Stroke="{DynamicResource TextFillColorPrimaryBrush}" StrokeThickness="1.2"/>
                        </Button>
                        <TextBlock Grid.Column="1" x:Name="DensityCols" Text="1" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Button Grid.Column="2" Style="{StaticResource DensityArrowStyle}" x:Name="ColsUp" Tag="Cols+" ToolTip="增加列数" Click="DensityStep_Click">
                            <Path Data="M 0,0 L 5,5 0,10" Stroke="{DynamicResource TextFillColorPrimaryBrush}" StrokeThickness="1.2"/>
                        </Button>
                    </Grid>
                </Border>
                <TextBlock Text="间距 (px)" VerticalAlignment="Center" Margin="8,0,6,0"/>
                <Border BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4" Width="80" Height="28">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/></Grid.ColumnDefinitions>
                        <Button Style="{StaticResource DensityArrowStyle}" x:Name="SpacingDown" Tag="-" ToolTip="减少间距" Click="SpacingStep_Click">
                            <Path Data="M 5,0 L 0,5 5,10" Stroke="{DynamicResource TextFillColorPrimaryBrush}" StrokeThickness="1.2"/>
                        </Button>
                        <TextBlock Grid.Column="1" x:Name="SpacingValue" Text="0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Button Grid.Column="2" Style="{StaticResource DensityArrowStyle}" x:Name="SpacingUp" Tag="+" ToolTip="增加间距" Click="SpacingStep_Click">
                            <Path Data="M 0,0 L 5,5 0,10" Stroke="{DynamicResource TextFillColorPrimaryBrush}" StrokeThickness="1.2"/>
                        </Button>
                    </Grid>
                </Border>
            </StackPanel>
            <Canvas x:Name="GridCanvas" Width="520" Height="280" Background="Transparent"
                    MouseLeftButtonDown="Canvas_MouseLeftButtonDown" MouseMove="Canvas_MouseMove"
                    MouseLeftButtonUp="Canvas_MouseLeftButtonUp" MouseLeave="Canvas_MouseLeave"/>
            <TextBlock Text="拖动框选，松开应用 · Esc 取消" FontSize="11" Margin="0,8,0,0"
                       HorizontalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
        </StackPanel>
    </Border>
</Window>
