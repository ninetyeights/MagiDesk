<Window x:Class="MagiDesk.Features.ProfileDock.ProfileDockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Profile Dock"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        Focusable="False"
        ResizeMode="NoResize"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        SizeToContent="WidthAndHeight">
    <Window.Resources>
        <!-- Placeholder values; ApplyTheme() swaps these at runtime from
             DockPalette, and everything below binds with DynamicResource so a
             Windows theme switch restyles the dock without rebuilding it. -->
        <SolidColorBrush x:Key="DockBackgroundBrush"  Color="#E8202020"/>
        <SolidColorBrush x:Key="DockBorderBrush"      Color="#26FFFFFF"/>
        <SolidColorBrush x:Key="DockHoverBrush"       Color="#1AFFFFFF"/>
        <SolidColorBrush x:Key="DockPressedBrush"     Color="#0DFFFFFF"/>
        <SolidColorBrush x:Key="DockTextBrush"        Color="#FFFFFFFF"/>
        <SolidColorBrush x:Key="DockSeparatorBrush"   Color="#2EFFFFFF"/>
        <SolidColorBrush x:Key="DockGroupBgBrush"     Color="#14FFFFFF"/>
        <SolidColorBrush x:Key="DockGroupBorderBrush" Color="#22FFFFFF"/>

        <!-- Taskbar button: no chrome of its own, just a rounded-square wash
             on hover / press, exactly like a Windows 11 taskbar icon. -->
        <Style x:Key="DockButtonStyle" TargetType="Button">
            <Setter Property="Background"        Value="Transparent"/>
            <Setter Property="BorderThickness"   Value="0"/>
            <Setter Property="Padding"           Value="0"/>
            <Setter Property="Focusable"         Value="False"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg"
                                Background="{TemplateBinding Background}"
                                CornerRadius="5"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background"
                                        Value="{DynamicResource DockHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background"
                                        Value="{DynamicResource DockPressedBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DockScrollButtonStyle" TargetType="Button" BasedOn="{StaticResource DockButtonStyle}">
            <Setter Property="Opacity" Value="0.35"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="1"/>
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="Opacity" Value="1"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border x:Name="DockRoot"
            CornerRadius="0"
            BorderThickness="1"
            BorderBrush="{DynamicResource DockBorderBrush}"
            Background="{DynamicResource DockBackgroundBrush}"
            Padding="8,4"
            MouseLeftButtonDown="Dock_MouseDown"
            MouseMove="Dock_MouseMove"
            MouseLeftButtonUp="Dock_MouseUp">
        <Grid x:Name="DockContent" HorizontalAlignment="Center">
            <Button x:Name="ScrollPrevious" Width="28" HorizontalAlignment="Left" Panel.ZIndex="1"
                    Background="{DynamicResource DockScrollBackgroundBrush}" PreviewMouseWheel="Items_MouseWheel"
                    Style="{StaticResource DockScrollButtonStyle}" Foreground="{DynamicResource DockTextBrush}"
                    Visibility="Collapsed" ToolTip="向左滚动" AutomationProperties.Name="向左滚动" Click="ScrollPrevious_Click">
                <Path Data="M 8,1 L 2,7 L 8,13" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                      StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
            </Button>
        <ScrollViewer x:Name="ItemsViewport" CanContentScroll="False"
                      HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                      PreviewMouseWheel="Items_MouseWheel" ScrollChanged="Items_ScrollChanged">
            <WrapPanel x:Name="ButtonPanel" Orientation="Horizontal"/>
        </ScrollViewer>
            <Button x:Name="ScrollFollowing" Width="28" HorizontalAlignment="Right" Panel.ZIndex="1"
                    Background="{DynamicResource DockScrollBackgroundBrush}" PreviewMouseWheel="Items_MouseWheel"
                    Style="{StaticResource DockScrollButtonStyle}" Foreground="{DynamicResource DockTextBrush}"
                    Visibility="Collapsed" ToolTip="向右滚动" AutomationProperties.Name="向右滚动" Click="ScrollFollowing_Click">
                <Path Data="M 2,1 L 8,7 L 2,13" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                      StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
            </Button>
        </Grid>
    </Border>
</Window>
