<Page x:Class="MagiDesk.Pages.ZonesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="窗口分区"
      x:Name="PageRoot">

    <!-- MaxHeight binds to Page.ActualHeight so the ScrollViewer can actually
         clip — without it, NavigationView's Frame hands the Page unbounded
         measurement and auto-hide scrollbars never trigger. -->
    <ScrollViewer Background="Transparent"
                  MaxHeight="{Binding ActualHeight, ElementName=PageRoot}"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Padding="0">
        <Grid Margin="16,0,20,16">
            <StackPanel HorizontalAlignment="Stretch" MaxWidth="1200">

                <!-- Header + compact settings row -->
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="窗口分区" FontSize="28" FontWeight="SemiBold"/>
                        <TextBlock Text="按住 Shift 拖动窗口，滚轮切换当前屏幕布局，松开鼠标吸附。每个显示器可独立配置。"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <StackPanel Margin="0,0,28,0" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="启用" FontSize="12"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,2"/>
                            <ui:ToggleSwitch x:Name="TsEnabled"
                                             HorizontalAlignment="Center"
                                             Checked="Enabled_Changed"
                                             Unchecked="Enabled_Changed"/>
                        </StackPanel>
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="拖动恢复" FontSize="12"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,2"/>
                            <ui:ToggleSwitch x:Name="TsRestore"
                                             HorizontalAlignment="Center"
                                             Checked="Restore_Changed"
                                             Unchecked="Restore_Changed"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <StackPanel x:Name="BodyGroup">

                <!-- Monitor arrangement strip -->
                <TextBlock Text="显示器" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Margin="0,4,0,6"/>
                <Border Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8" Padding="16,14" Margin="0,0,0,18">
                    <Border.Effect>
                        <DropShadowEffect Color="Black" BlurRadius="10" ShadowDepth="2" Direction="270" Opacity="0.12"/>
                    </Border.Effect>
                    <Canvas x:Name="MonitorCanvas" Height="160"/>
                </Border>

                <!-- Templates -->
                <TextBlock Text="模板" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Margin="0,0,0,6"/>
                <ItemsControl x:Name="TemplatesList" Margin="0,0,0,18">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>

                <!-- Custom layouts -->
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="自定义" FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               VerticalAlignment="Center"/>
                    <ui:Button Grid.Column="1" x:Name="BtnCreateNew"
                               Content="+ 新建布局"
                               Appearance="Primary"
                               Click="BtnCreateNew_Click"/>
                </Grid>
                <ItemsControl x:Name="CustomList" Margin="0,0,0,18">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>

                <TextBlock x:Name="TxtEmpty"
                           Text="暂无自定义布局。点击「新建布局」开始。"
                           FontSize="12"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Margin="0,-10,0,18"
                           Visibility="Collapsed"/>

                <ui:InfoBar HorizontalAlignment="Stretch"
                            IsOpen="True" IsClosable="False"
                            Severity="Informational"
                            Title="用法"
                            Message="先在顶部选择显示器 → 点击模板或自定义布局应用。编辑自定义布局点铅笔图标。"
                            Margin="0,4,0,0"/>

                </StackPanel>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
