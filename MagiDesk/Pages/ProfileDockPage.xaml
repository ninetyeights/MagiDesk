<Page x:Class="MagiDesk.Pages.ProfileDockPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Dock"
      x:Name="PageRoot">
    <ScrollViewer Background="Transparent"
                  MaxHeight="{Binding ActualHeight, ElementName=PageRoot}"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Padding="0">
        <Grid Margin="16,0,20,16">
            <StackPanel HorizontalAlignment="Stretch" MaxWidth="1100">
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,24,0">
                        <TextBlock Text="Dock" FontSize="28" FontWeight="SemiBold"/>
                        <TextBlock Text="固定常用应用和浏览器账号，点击启动或切换窗口；支持悬浮和任务栏模式。" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="启用" FontSize="12" HorizontalAlignment="Center" Margin="0,0,0,2"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        <ui:ToggleSwitch x:Name="TsDock" HorizontalAlignment="Center"
                                         Checked="Dock_Changed" Unchecked="Dock_Changed"/>
                    </StackPanel>
                </Grid>

                <ui:InfoBar HorizontalAlignment="Stretch"
                            IsOpen="True"
                            IsClosable="False"
                            Severity="Informational"
                            Title="头像与可见性"
                            Message="每个 profile 的头像、颜色和显示/隐藏在「浏览器 → 徽标」页里设置，dock 与徽标共用同一套。"
                            Margin="0,0,0,12"/>

                <!-- Enable -->

                <StackPanel x:Name="DockBody">
                <ui:Card HorizontalAlignment="Stretch" Padding="18,16" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="内容超出时" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <ComboBox x:Name="CmbOverflow" SelectionChanged="Overflow_Changed">
                            <ComboBoxItem Content="横向滚动"/>
                            <ComboBoxItem Content="自动换行"/>
                        </ComboBox>
                        <TextBlock x:Name="TxtMaxWidth" Margin="0,10,0,4"/>
                        <Slider x:Name="SlMaxWidth" Minimum="30" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True" ValueChanged="Overflow_Changed"/>
                        <TextBlock Text="换行模式按内容自动增高，不滚动。任务栏模式使用显示器可用宽度；其他模式可用滚轮查看超出内容。"
                                   TextWrapping="Wrap" Margin="0,8,0,0" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </ui:Card>

                <ui:Card HorizontalAlignment="Stretch" Padding="18,16" Margin="0,0,0,12">
                    <DockPanel>
                        <ui:ToggleSwitch x:Name="TsRunningApplications" DockPanel.Dock="Right" VerticalAlignment="Center"
                                         Checked="RunningApplications_Changed" Unchecked="RunningApplications_Changed"/>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="显示正在运行的应用" FontWeight="SemiBold"/>
                            <TextBlock Text="未固定的已打开应用显示在末尾；已固定或已显示在浏览器分组中的项目保持原位置，不重复显示。"
                                       TextWrapping="Wrap" FontSize="12" Margin="0,4,0,0"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                    </DockPanel>
                </ui:Card>

                <!-- Dock mode: floating overlay vs taskbar-style appbar -->
                <ui:Card HorizontalAlignment="Stretch" Padding="18,16" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="200"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="停靠模式" FontWeight="SemiBold"/>
                            <TextBlock Text="悬浮：自由拖到桌面任意位置，悬浮在最上层。任务栏：像系统任务栏一样固定在屏幕顶部并预留空间，最大化的窗口不会被遮挡。"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,2,8,0"/>
                        </StackPanel>
                        <ComboBox Grid.Column="1" x:Name="CmbDockMode"
                                  VerticalAlignment="Center"
                                  VerticalContentAlignment="Center"
                                  SelectionChanged="DockMode_Changed">
                            <ComboBoxItem Content="悬浮"/>
                            <ComboBoxItem Content="任务栏（顶部固定）"/>
                        </ComboBox>
                    </Grid>
                </ui:Card>

                <ui:Card HorizontalAlignment="Stretch" Padding="18,16" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="200"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="任务栏按钮位置" FontWeight="SemiBold"/>
                            <TextBlock Text="仅用于任务栏模式，默认居中。" FontSize="12"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,8,0"/>
                        </StackPanel>
                        <ComboBox Grid.Column="1" x:Name="CmbDockAlignment"
                                  VerticalAlignment="Center" SelectionChanged="DockAlignment_Changed">
                            <ComboBoxItem Content="居中"/>
                            <ComboBoxItem Content="靠左"/>
                        </ComboBox>
                    </Grid>
                </ui:Card>

                <ui:Card x:Name="FloatingSettings" HorizontalAlignment="Stretch" Padding="18,16" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="悬浮位置" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <WrapPanel>
                            <ComboBox x:Name="CmbFloatingEdge" Width="150" Margin="0,0,8,8" SelectionChanged="Floating_Changed">
                                <ComboBoxItem Content="贴到顶部"/><ComboBoxItem Content="贴到底部"/><ComboBoxItem Content="自由摆放"/>
                            </ComboBox>
                            <ComboBox x:Name="CmbFloatingAlign" Width="120" Margin="0,0,8,8" SelectionChanged="Floating_Changed">
                                <ComboBoxItem Content="靠左"/><ComboBoxItem Content="居中"/><ComboBoxItem Content="靠右"/>
                            </ComboBox>
                            <TextBlock Text="边缘间距" VerticalAlignment="Center" Margin="0,0,8,8"/>
                            <Slider x:Name="SlFloatingGap" Width="120" Minimum="0" Maximum="32" TickFrequency="1" IsSnapToTickEnabled="True"
                                    VerticalAlignment="Center" ValueChanged="Floating_Changed" Margin="0,0,8,8"/>
                            <TextBlock x:Name="TxtFloatingGap" VerticalAlignment="Center" Margin="0,0,0,8"/>
                        </WrapPanel>
                        <CheckBox x:Name="ChkDockRounded" Content="圆角" Checked="Floating_Changed" Unchecked="Floating_Changed" Margin="0,0,0,8"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="显示方式" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <ComboBox x:Name="CmbFloatingDisplayMode" Width="180" SelectionChanged="Floating_Changed">
                                <ComboBoxItem Content="智能避让（推荐）"/><ComboBoxItem Content="自动隐藏"/><ComboBoxItem Content="始终显示"/>
                            </ComboBox>
                        </StackPanel>
                        <WrapPanel x:Name="FloatingHideDelaySettings" Margin="0,2,0,8">
                            <TextBlock Text="隐藏延迟" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <ComboBox x:Name="CmbFloatingHideDelay" Width="150" SelectionChanged="FloatingHideDelay_Changed">
                                <ComboBoxItem Content="立即"/><ComboBoxItem Content="短暂（150 ms）"/><ComboBoxItem Content="自定义"/>
                            </ComboBox>
                            <StackPanel x:Name="CustomFloatingHideDelay" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                                <Slider x:Name="SlFloatingHideDelay" Width="140" Minimum="0" Maximum="2000" TickFrequency="10" IsSnapToTickEnabled="True" ValueChanged="FloatingHideDelay_Changed"/>
                                <TextBlock x:Name="TxtFloatingHideDelay" MinWidth="60" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </WrapPanel>
                        <TextBlock Text="贴边时位置固定，请通过设置调整位置和对齐；图标仍可拖动排序。智能避让会在当前应用与 Dock 重叠时收起，触边立即唤出。自由摆放时可拖动空白处移动，并保持显示。"
                                   TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </ui:Card>

                <!-- Chrome colour scheme: follow Windows, or force light/dark -->
                <ui:Card HorizontalAlignment="Stretch" Padding="18,16" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="200"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="外观主题" FontWeight="SemiBold"/>
                            <TextBlock Text="dock 采用 Windows 11 任务栏样式（悬停高亮、运行/当前窗口指示条）。「跟随系统」会在你切换 Windows 浅色/深色时实时跟着变。"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,2,8,0"/>
                        </StackPanel>
                        <ComboBox Grid.Column="1" x:Name="CmbDockTheme"
                                  VerticalAlignment="Center"
                                  VerticalContentAlignment="Center"
                                  SelectionChanged="DockTheme_Changed">
                            <ComboBoxItem Content="跟随系统"/>
                            <ComboBoxItem Content="浅色"/>
                            <ComboBoxItem Content="深色"/>
                        </ComboBox>
                    </Grid>
                </ui:Card>

                <!-- Monitor targeting: single (pick which) vs all monitors -->
                <ui:Card HorizontalAlignment="Stretch" Padding="18,16" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="显示器" FontWeight="SemiBold"/>
                            <TextBlock Text="选择 dock 出现在哪块屏幕。「所有显示器」会在每块屏幕上各显示一条（任务栏模式则每块屏幕顶部各预留一条）。"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,2,8,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Vertical" VerticalAlignment="Center">
                            <ComboBox x:Name="CmbMonitorMode"
                                      Width="200"
                                      VerticalContentAlignment="Center"
                                      SelectionChanged="MonitorMode_Changed">
                                <ComboBoxItem Content="单个显示器"/>
                                <ComboBoxItem Content="所有显示器"/>
                            </ComboBox>
                            <ComboBox x:Name="CmbMonitor"
                                      Width="200"
                                      Margin="0,8,0,0"
                                      VerticalContentAlignment="Center"
                                      SelectionChanged="Monitor_Changed"/>
                        </StackPanel>
                    </Grid>
                </ui:Card>

                <!-- Dock icon size -->
                <ui:Card HorizontalAlignment="Stretch" Padding="18,16" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="Dock 图标大小" FontWeight="SemiBold"/>
                            <ComboBox x:Name="CmbIconSizing" Width="180" HorizontalAlignment="Left" Margin="0,8,0,4" SelectionChanged="IconSizing_Changed">
                                <ComboBoxItem Content="固定大小"/><ComboBoxItem Content="按屏幕适配"/>
                            </ComboBox>
                            <ComboBox x:Name="CmbIconSizeTarget" MinWidth="180" HorizontalAlignment="Left" Margin="0,4,12,4" SelectionChanged="IconSizeTarget_Changed"/>
                            <CheckBox x:Name="ChkInheritIconSize" Content="使用全局设置" Margin="0,4,0,4" Checked="InheritIconSize_Changed" Unchecked="InheritIconSize_Changed"/>
                            <TextBlock Text="适配模式仅在可用逻辑宽度小于 1920 时缩小，最低 24；宽屏不放大，开关应用不改变大小。单独指定显示器时使用固定大小。"
                                       TextWrapping="Wrap"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Margin="0,2,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Slider x:Name="DockSizeSlider" Width="180" Minimum="24" Maximum="72"
                                    IsSnapToTickEnabled="True" TickFrequency="1" SmallChange="1" LargeChange="1"
                                    ValueChanged="DockSize_Changed"/>
                            <TextBlock x:Name="TxtDockSize" Margin="10,0,0,0" VerticalAlignment="Center" Width="40"/>
                        </StackPanel>
                    </Grid>
                </ui:Card>

                <ui:Card HorizontalAlignment="Stretch" Padding="18,16" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="分组样式" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <ComboBox x:Name="CmbSeparator" SelectionChanged="Separator_Changed">
                            <ComboBoxItem Content="空隙"/><ComboBoxItem Content="竖线"/>
                            <ComboBoxItem Content="分组名称"/><ComboBoxItem Content="半透边框"/>
                        </ComboBox>
                        <TextBlock Text="在左侧「Dock → 内容管理」中管理浏览器账号、应用、集合和分组。"
                                   TextWrapping="Wrap" Margin="0,8,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </ui:Card>

                </StackPanel>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
