<Page x:Class="MagiDesk.Pages.BrowserBadgesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="浏览器 Profile 徽标"
      x:Name="PageRoot">
    <ScrollViewer Background="Transparent"
                  MaxHeight="{Binding ActualHeight, ElementName=PageRoot}"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Padding="0">
        <Grid Margin="16,0,20,16">
            <StackPanel HorizontalAlignment="Stretch" MaxWidth="1100">
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,24,0">
                        <TextBlock Text="浏览器 Profile 徽标" FontSize="28" FontWeight="SemiBold"/>
                        <TextBlock Text="每个 Chrome profile 的窗口右上角浮一个胶囊，显示头像和 profile 名字，方便区分多窗口。每个 profile 可单独设颜色、自定义头像和开关。" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="启用" FontSize="12" HorizontalAlignment="Center" Margin="0,0,0,2"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        <ui:ToggleSwitch x:Name="TsEnabled" HorizontalAlignment="Center"
                                         Checked="Enabled_Changed" Unchecked="Enabled_Changed"/>
                    </StackPanel>
                </Grid>

                <ui:InfoBar HorizontalAlignment="Stretch"
                            IsOpen="True"
                            IsClosable="False"
                            Severity="Informational"
                            Title="关于窗口层级"
                            Message="启用徽标或 MagiDesk 启动时，已打开的 Chrome 窗口会被一起前置，最终顺序不固定（Windows 的 owner 机制所致）。"
                            Margin="0,0,0,12"/>


                <!-- Enable -->

                <StackPanel x:Name="BodyGroup">

                <!-- Size -->
                <ui:Card HorizontalAlignment="Stretch" Padding="18,16" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="260"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="徽标尺寸" FontWeight="SemiBold"/>
                            <TextBlock Text="胶囊高度 (px)，宽度按内容自适应"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Margin="0,2,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Slider x:Name="SizeSlider" Width="180" Minimum="20" Maximum="64"
                                    IsSnapToTickEnabled="True" TickFrequency="2"
                                    ValueChanged="Size_Changed"/>
                            <TextBlock x:Name="TxtSize" Margin="10,0,0,0" VerticalAlignment="Center" Width="40"/>
                        </StackPanel>
                    </Grid>
                </ui:Card>

                <!-- Show name -->
                <ui:Card HorizontalAlignment="Stretch" Padding="18,16" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="显示 Profile 名称" FontWeight="SemiBold"/>
                            <TextBlock Text="关闭后徽标只显示头像，胶囊会收缩到头像大小。"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Margin="0,2,0,0"/>
                        </StackPanel>
                        <ui:ToggleSwitch x:Name="TsShowName" Grid.Column="1"
                                         VerticalAlignment="Center"
                                         Checked="ShowName_Changed" Unchecked="ShowName_Changed"/>
                    </Grid>
                </ui:Card>

                <!-- First word only -->
                <ui:Card HorizontalAlignment="Stretch" Padding="18,16" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="仅显示首个单词" FontWeight="SemiBold"/>
                            <TextBlock Text="开启时 &quot;N808 Carlos Ribeiro&quot; 只显示 &quot;N808&quot;，避免长名字撑爆徽标。"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,2,8,0"/>
                        </StackPanel>
                        <ui:ToggleSwitch x:Name="TsFirstWord" Grid.Column="1"
                                         VerticalAlignment="Center"
                                         Checked="FirstWord_Changed" Unchecked="FirstWord_Changed"/>
                    </Grid>
                </ui:Card>

                <!-- Position (drag to customize) -->
                <ui:Card HorizontalAlignment="Stretch" Padding="18,16" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="调整位置" FontWeight="SemiBold"/>
                            <ComboBox x:Name="PositionBrowser" MinWidth="200" HorizontalAlignment="Left"
                                      Margin="0,8,8,6" SelectionChanged="PositionBrowser_Changed"/>
                            <CheckBox x:Name="InheritPosition" Content="使用默认位置" Margin="0,0,8,6"
                                      Checked="InheritPosition_Changed" Unchecked="InheritPosition_Changed"/>
                            <TextBlock x:Name="TxtPositionAdjustment" Text="临时拖动徽标调整位置；点击完成或按 Esc 保存并恢复鼠标穿透，重启后保持锁定。"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,2,8,0"/>
                        </StackPanel>
                        <ui:Button x:Name="BtnResetPos" Grid.Column="1"
                                   Content="恢复默认位置"
                                   Padding="12,6"
                                   Margin="0,0,10,0"
                                   VerticalAlignment="Center"
                                   Click="ResetPos_Click"/>
                        <ui:Button x:Name="BtnAdjustPosition" Grid.Column="2" Content="调整位置" Padding="12,6"
                                   VerticalAlignment="Center" Click="AdjustPosition_Click"/>
                    </Grid>
                </ui:Card>

                <!-- Profiles list -->
                <ui:Card HorizontalAlignment="Stretch" Padding="18,16" Margin="0,0,0,12">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="检测到的 Profile" FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                            <ui:Button Grid.Column="1" Content="刷新" Padding="12,4"
                                       Click="Refresh_Click"/>
                        </Grid>
                        <ui:TextBox x:Name="TxtSearch"
                                    Margin="0,0,0,10"
                                    PlaceholderText="搜索 profile（名称 / 浏览器 / 目录）"
                                    TextChanged="Search_Changed"/>
                        <WrapPanel Margin="0,0,0,10">
                            <ui:Button Content="全选结果" Click="SelectBadgeResults_Click" Margin="0,0,6,6"/>
                            <ui:Button Content="清除选择" Click="ClearBadgeSelection_Click" Margin="0,0,6,6"/>
                            <ui:Button Content="批量修改…" Click="BatchBadge_Click" Margin="0,0,8,6"/>
                            <TextBlock x:Name="BadgeSelectionCount" VerticalAlignment="Center" Text="已选 0 项"/>
                        </WrapPanel>
                        <StackPanel x:Name="ProfileList"/>
                        <TextBlock x:Name="TxtEmpty"
                                   Text="没找到浏览器 profile。请确认 Chrome / Edge / Brave / Vivaldi 等已安装并至少启动过一次。"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   FontSize="12"
                                   Margin="0,8,0,0"
                                   Visibility="Collapsed"/>
                    </StackPanel>
                </ui:Card>

                </StackPanel>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
