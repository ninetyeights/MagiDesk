<Page x:Class="MagiDesk.Pages.AboutPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="关于">

    <ScrollViewer Background="Transparent"
                  VerticalScrollBarVisibility="Auto"
                  Padding="0">
        <Grid Margin="16,0,20,16">
            <StackPanel HorizontalAlignment="Stretch" MaxWidth="1000">
            <TextBlock Text="关于 MagiDesk"
                       FontSize="28" FontWeight="SemiBold"/>
            <TextBlock Text="桌面魔方 · Windows 桌面增强工具集"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Margin="0,2,0,20"/>

            <ui:Card HorizontalAlignment="Stretch" Padding="18,16" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="版本" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <TextBlock x:Name="TxtVersion" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    <TextBlock Text="技术栈" FontWeight="SemiBold" Margin="0,16,0,6"/>
                    <TextBlock Text=".NET 10 · WPF · WPF-UI (Fluent)"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
            </ui:Card>

            <ui:Card HorizontalAlignment="Stretch" Padding="18,16" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="应用更新" FontWeight="SemiBold"/>
                    <CheckBox x:Name="AutoUpdates" Content="自动检查更新" Margin="0,10,0,8"
                              Checked="AutoUpdates_Changed" Unchecked="AutoUpdates_Changed"/>
                    <TextBlock Text="从 GitHub 检查更新，下载和安装由你确认。测试版接收测试版及正式版，正式版只接收正式版。"
                               TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    <TextBlock x:Name="UpdateStatus" TextWrapping="Wrap" Margin="0,10,0,10"/>
                    <WrapPanel>
                        <Button x:Name="CheckUpdate" Content="检查更新" Click="CheckUpdate_Click" Margin="0,0,8,8"/>
                        <Button x:Name="DownloadUpdate" Content="下载更新" Click="DownloadUpdate_Click" Margin="0,0,8,8"/>
                        <Button x:Name="InstallUpdate" Content="退出并安装" Click="InstallUpdate_Click" Margin="0,0,8,8"/>
                        <Button x:Name="CancelUpdate" Content="取消" Click="CancelUpdate_Click" Margin="0,0,8,8"/>
                    </WrapPanel>
                    <TextBlock x:Name="ReleaseNotes" TextWrapping="Wrap" MaxHeight="240" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </ui:Card>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
