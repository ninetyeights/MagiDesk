<Page x:Class="MagiDesk.Pages.AboutPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="关于">

    <ScrollViewer Background="Transparent"
                  VerticalScrollBarVisibility="Auto"
                  Padding="0">
        <Grid Margin="16,16,20,16">
            <StackPanel HorizontalAlignment="Stretch" MaxWidth="1000">
            <TextBlock Text="关于 MagiDesk"
                       FontSize="28" FontWeight="SemiBold"/>
            <TextBlock Text="桌面魔方 · Windows 桌面增强工具集"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Margin="0,2,0,20"/>

            <ui:Card HorizontalAlignment="Stretch" Padding="18,16" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="版本" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <TextBlock x:Name="TxtVersion" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    <TextBlock Text="技术栈" FontWeight="SemiBold" Margin="0,16,0,6"/>
                    <TextBlock Text=".NET 10 · WPF · WPF-UI (Fluent)"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
            </ui:Card>

            <ui:Card HorizontalAlignment="Stretch" Padding="18,16">
                <StackPanel>
                    <TextBlock Text="已实现的工具" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <TextBlock Text="• 窗口拖动 — AltSnap 风格的快速移动 / 缩放"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Margin="0,2"/>
                    <TextBlock Text="更多工具陆续加入..."
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               FontStyle="Italic"
                               Margin="0,12,0,2"/>
                </StackPanel>
            </ui:Card>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
