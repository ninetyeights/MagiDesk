<UserControl x:Class="MagiDesk.Controls.DockProjectManager"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="clr-namespace:MagiDesk.Controls"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      FocusVisualStyle="{x:Null}"
      MaxHeight="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=ScrollContentPresenter}}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanVisibility"/>
        <Style x:Key="InlineAction" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ProjectCheckBox" TargetType="CheckBox">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Width="22" Height="32" Background="Transparent">
                            <Border x:Name="Box" Width="20" Height="20" CornerRadius="4" BorderThickness="1.5"
                                    BorderBrush="{DynamicResource TextFillColorSecondaryBrush}" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"/>
                            <Path x:Name="Check" Data="M 5,16 L 9,20 L 17,12" Stroke="{DynamicResource TextOnAccentFillColorPrimaryBrush}" StrokeThickness="2.5"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
                                <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Padding" Value="6,5"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HeaderTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <Border Padding="4,2">
                            <TextBlock x:Name="HeaderLabel" Text="{Binding}"/>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=TreeViewItem}}" Value="True">
                                <Setter TargetName="HeaderLabel" Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
                                <Setter TargetName="HeaderLabel" Property="FontWeight" Value="SemiBold"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SmallAction" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="0,0,6,4"/>
            <Setter Property="MinHeight" Value="32"/>
        </Style>
        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="12,5,8,5"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid Background="Transparent" Margin="0,1">
                            <Border x:Name="RowSurface" CornerRadius="5" Background="Transparent"/>
                            <Border x:Name="CheckedSurface" CornerRadius="5" Background="{DynamicResource AccentFillColorDefaultBrush}"
                                    Opacity="0.18" Visibility="Collapsed" IsHitTestVisible="False"/>
                            <Border x:Name="ActiveMarker" Width="3" Height="18" CornerRadius="1.5" HorizontalAlignment="Left"
                                    Background="{DynamicResource AccentTextFillColorPrimaryBrush}" Visibility="Collapsed"/>
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Stretch"
                                              TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="RowSurface" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/></Trigger>
                            <DataTrigger Binding="{Binding IsChecked}" Value="True">
                                <Setter TargetName="CheckedSurface" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ActiveMarker" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <DataTemplate x:Key="ProjectRow">
            <Grid ToolTip="{Binding Detail}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="0.9*" MaxWidth="340"/><ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" Style="{StaticResource ProjectCheckBox}"
                          HorizontalAlignment="Left" VerticalAlignment="Center" Focusable="False"
                          MinWidth="0" MinHeight="32" Padding="0" Margin="0,0,8,0"/>
                <Grid Grid.Column="1" Margin="0,0,16,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Width="28" Height="28" CornerRadius="5" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                        <Grid Loaded="ProjectIcon_Loaded" DataContextChanged="ProjectIcon_DataContextChanged">
                            <TextBlock Text="▪" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Image Stretch="Uniform"/>
                        </Grid>
                    </Border>
                    <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                </Grid>
                <local:DockMembershipStrip Grid.Column="2" Memberships="{Binding Memberships}"
                                           RemoveRequested="RemoveRowMembership_Click" ManageRequested="MoreMemberships_Click"/>
                <Button Grid.Column="3" Content="＋" Style="{StaticResource InlineAction}" Click="AddRowMembership_Click" Padding="4,0" MinWidth="26" Height="28" Margin="4,0,0,0" ToolTip="添加到集合"/>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>
    <Grid Margin="16,0,20,16">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,14">
            <TextBlock x:Name="PageHeading" Text="Dock 内容管理" FontSize="28" FontWeight="SemiBold"/>
            <TextBlock x:Name="PageDescription" Text="集合是一整套 Dock。选择集合，勾选浏览器账号和应用，批量加入分组。"
                       TextWrapping="Wrap" Margin="0,4,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
        </StackPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition x:Name="CollectionColumn" Width="210"/><ColumnDefinition x:Name="CollectionGutter" Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border x:Name="CollectionSidebar" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="8">
                <DockPanel>
                    <WrapPanel DockPanel.Dock="Top">
                        <Button Content="＋集合" Style="{StaticResource SmallAction}" Click="NewCollection_Click"/>
                    </WrapPanel>
                    <TextBlock DockPanel.Dock="Bottom" Text="展开集合查看分组，右键管理或拖动调整顺序。" TextWrapping="Wrap"
                               FontSize="12" Margin="4,8,4,4" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    <TreeView x:Name="CollectionTree" Background="Transparent" BorderThickness="0" FocusVisualStyle="{x:Null}"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              SelectedItemChanged="Tree_SelectedItemChanged"/>
                </DockPanel>
            </Border>
            <Grid Grid.Column="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="MemberColumn" Width="*"/>
                    <ColumnDefinition x:Name="LibraryColumn" Width="0"/>
                </Grid.ColumnDefinitions>
                <Grid x:Name="MainContent">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,12">
                        <Button x:Name="ActivateButton" DockPanel.Dock="Right" Content="设为当前 Dock" Click="Activate_Click" Style="{StaticResource SmallAction}"/>
                        <StackPanel>
                            <TextBlock x:Name="CollectionTitle" FontSize="20" FontWeight="SemiBold"/>
                            <TextBlock x:Name="CollectionHint" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                    </DockPanel>
                    <WrapPanel Grid.Row="1" Margin="0,0,0,8">
                        <Button Content="添加项目" Click="OpenLibrary_Click" Style="{StaticResource SmallAction}"/>
                        <Button Content="＋分组" Click="NewSegment_Click" Style="{StaticResource SmallAction}"/>
                        <Button x:Name="MoveUpButton" Content="上移" Click="MoveUp_Click" Style="{StaticResource SmallAction}"/>
                        <Button x:Name="MoveDownButton" Content="下移" Click="MoveDown_Click" Style="{StaticResource SmallAction}"/>
                        <Button Content="移除所选" Click="RemoveSelected_Click" Style="{StaticResource SmallAction}"/>
                        <Button x:Name="SegmentMenuButton" Content="分组管理…" Click="SegmentMenu_Click" Style="{StaticResource SmallAction}"/>
                        <TextBlock x:Name="MemberSummary" VerticalAlignment="Center" Margin="4,0,0,4"/>
                    </WrapPanel>
                    <Grid Grid.Row="2">
                        <ListBox x:Name="MemberList" SelectionMode="Single" ItemTemplate="{StaticResource ProjectRow}"
                                 VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" AllowDrop="True" Drop="Members_Drop"
                                 DragOver="Members_DragOver" PreviewMouseLeftButtonDown="Members_MouseDown" PreviewMouseMove="Members_MouseMove"/>
                        <TextBlock x:Name="EmptyMembers" Text="暂无项目，点击“添加项目”从项目库批量加入。"
                                   TextWrapping="Wrap" Margin="24" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    </Grid>
                    <StackPanel Grid.Row="3" Margin="0,10,0,0">
                        <CheckBox x:Name="IncludeUngrouped" Content="此集合也显示未加入分组的浏览器账号"
                                  Checked="IncludeUngrouped_Changed" Unchecked="IncludeUngrouped_Changed"/>
                    </StackPanel>
                </Grid>
                <Border x:Name="LibraryPanel" Grid.Column="1" Visibility="Collapsed" HorizontalAlignment="Stretch"
                        Background="{DynamicResource SolidBackgroundFillColorBaseBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <DockPanel x:Name="LibraryPanelHeader" Margin="0,0,0,10">
                            <Button x:Name="CloseLibraryButton" DockPanel.Dock="Right" Content="关闭" Click="CloseLibrary_Click" Style="{StaticResource SmallAction}"/>
                            <TextBlock Text="项目库" FontSize="22" FontWeight="SemiBold"/>
                        </DockPanel>
                        <WrapPanel Grid.Row="1">
                            <ui:TextBox x:Name="SearchBox" Width="230" MinHeight="34" Padding="8,4" VerticalContentAlignment="Center" PlaceholderText="搜索名称、浏览器或路径…"
                                     ToolTip="搜索名称、浏览器或路径" TextChanged="Filter_Changed" Margin="0,0,8,6"/>
                            <ComboBox x:Name="TypeFilter" Width="155" MinHeight="34" DisplayMemberPath="Label"
                                      SelectionChanged="Filter_Changed" Margin="0,0,8,6"/>
                            <Button Content="导入应用…" Click="AddApplication_Click" Style="{StaticResource SmallAction}"/>
                            <Button Content="识别模拟器实例" ToolTip="将本机 BlueStacks 和 MSI App Player 实例导入项目库，已有实例自动跳过。" Click="DiscoverEmulators_Click" Style="{StaticResource SmallAction}"/>
                            <Button Content="刷新" Click="Refresh_Click" Style="{StaticResource SmallAction}"/>
                        </WrapPanel>
                        <WrapPanel Grid.Row="3" Margin="0,0,0,6">
                            <Button Content="全选结果" Click="SelectAll_Click" Style="{StaticResource SmallAction}"/>
                            <Button Content="清除选择" Click="ClearSelection_Click" Style="{StaticResource SmallAction}"/>
                            <Button x:Name="AddSelectedButton" Content="添加到…" Click="AddSelected_Click" Style="{StaticResource SmallAction}"/>
                            <Button x:Name="RemoveLibraryButton" Content="从集合移除…" Click="RemoveLibraryReferences_Click" Style="{StaticResource SmallAction}"/>
                            <Button x:Name="DeleteLibraryButton" Content="删除应用…" Click="DeleteLibraryApplications_Click" Style="{StaticResource SmallAction}"/>
                            <TextBlock x:Name="LibrarySummary" VerticalAlignment="Center" TextWrapping="Wrap" FontSize="12"/>
                        </WrapPanel>
                        <ListBox x:Name="LibraryList" Grid.Row="4" SelectionMode="Single" ItemTemplate="{StaticResource ProjectRow}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                                 VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True"
                                 AllowDrop="True" DragOver="Applications_DragOver" Drop="Applications_Drop" ContextMenuOpening="Library_ContextMenuOpening">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                    <Setter Property="IsEnabled" Value="{Binding CanAdd}"/>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.HeaderTemplate>
                                        <DataTemplate><TextBlock Text="{Binding Name}" FontWeight="SemiBold" Margin="8,12,0,6"/></DataTemplate>
                                    </GroupStyle.HeaderTemplate>
                                </GroupStyle>
                            </ListBox.GroupStyle>
                        </ListBox>
                        <TextBlock x:Name="ApplicationStatus" Grid.Row="6" TextWrapping="Wrap" Margin="0,8,0,0"
                                   FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
